# frontend-global/.env.example — copy to .env.local (never committed).
# Every variable is optional for `npm run build`: with a variable missing the board renders an
# honest "not configured" state instead of failing.

# Postgres — the Supabase TRANSACTION-mode pooler (port 6543) as the atlas_global_app role.
# Not session mode (5432): the global board never relies on SET LOCAL or a pinned connection,
# and India's session-mode pool already holds 14 of the 15 slots.
ATLAS_GLOBAL_DB_URL=postgresql://atlas_global_app:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth (magic link). Both values are the public, browser-safe keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# The publish webhook: POST /api/revalidate with `Authorization: Bearer <this value>` and body
# {"tag":"eod"} re-renders every page cached under the 'eod' tag. The orchestrator on the box
# sends it once every gate has passed (scripts/ops/atlas_global_daily.sh) — the same value goes
# in the box .env as GLOBAL_REVALIDATE_SECRET next to GLOBAL_REVALIDATE_URL. Unset = the route
# refuses every call with 401. Generate: openssl rand -hex 32
GLOBAL_REVALIDATE_SECRET=<long random string>
